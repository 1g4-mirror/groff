bin_PROGRAMS += hpftodit
man1_MANS += src/utils/hpftodit/hpftodit.1
EXTRA_DIST += src/utils/hpftodit/hpftodit.1.man
hpftodit_LDADD = libgroff.a $(LIBM) lib/libgnu.a
hpftodit_SOURCES = \
  src/utils/hpftodit/hpftodit.cpp \
  src/utils/hpftodit/hpftodit.h \
  src/utils/hpftodit/hpuni.cpp

hpftodit_TESTS = \
  src/utils/hpftodit/tests/avoids-heap-buffer-overflow.sh \
  src/utils/hpftodit/tests/handles-font-names-carefully.sh
TESTS += $(hpftodit_TESTS)
EXTRA_DIST += $(hpftodit_TESTS)

